per_frame_5=cy = 0.5 + 0.1*cos(time*0.13);
per_frame_6=decay = 0.98 - 0.01*treble;
per_frame_7=r = 0.3 + 0.4*bass;
per_frame_8=g = 0.1 + 0.3*mid;
per_frame_9=b = 0.5 + 0.4*treble;

