[preset00]
fRating=5.000000
fGammaAdj=1.800000
fDecay=0.960000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800000
fWaveScale=0.300000
fWaveSmoothing=0.820000
fWaveParam=-0.010000
fModWaveAlphaStart=0.650000
fModWaveAlphaEnd=0.980000
fWarpAnimSpeed=1.500000
fWarpScale=1.800000
fZoomExponent=1.000000
fShader=0.000000
zoom=1.010000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=1.200000
sx=1.000000
sy=1.000000

; Per-frame equations — audio-reactive fractal stream parameters
per_frame_1=q1 = bass * 0.6 + 0.4
per_frame_2=q2 = treble * 0.5 + 0.3
per_frame_3=q3 = mid * 0.4 + 0.2
per_frame_4=zoom = 1.0 + bass * 0.06 + sin(time * 0.3) * 0.01
per_frame_5=rot = sin(time * 0.17) * 0.015 + mid * 0.008
per_frame_6=warp = 1.0 + treble * 0.8 + bass * 0.4
per_frame_7=cx = 0.5 + sin(time * 0.11) * 0.08
per_frame_8=cy = 0.5 + cos(time * 0.13) * 0.08
per_frame_9=dx = sin(time * 0.07 + bass) * 0.003
per_frame_10=dy = cos(time * 0.09 + mid) * 0.003
per_frame_11=decay = 0.955 + bass * 0.025
per_frame_12=gamma = 1.6 + treble * 0.5

; Wave (oscilloscope line that reacts to bass bursts)
per_frame_13=wave_r = 0.4 + bass * 0.6
per_frame_14=wave_g = 0.1 + mid * 0.5
per_frame_15=wave_b = 0.7 + treble * 0.3
per_frame_16=wave_a = 0.6 + vol * 0.4
per_frame_17=wave_scale = 0.2 + bass * 0.4
per_frame_18=wave_smoothing = 0.75 + mid * 0.1
