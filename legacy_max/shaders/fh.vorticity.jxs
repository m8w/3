<?xml version="1.0" encoding="UTF-8"?>
<jittershader name="fh.vorticity">
	<description>
		Vorticity confinement - adds small-scale rotation back into the fluid to
		counter numerical damping. Produces expressive, curling flow.
		tex0 = current field (RG velocity, B temp, A density)
	</description>
	<param name="tex0" type="int" default="0" />
	<param name="texdim" type="vec2" state="TEXDIM0" />
	<param name="epsilon" type="float" default="0.35" />
	<param name="dt" type="float" default="0.016" />
	<param name="modelViewProjectionMatrix" type="mat4" state="MODELVIEW_PROJECTION_MATRIX" />
	<param name="textureMatrix0" type="mat4" state="TEXTURE0_MATRIX" />
	<param name="position" type="vec3" state="POSITION" />
	<param name="texcoord" type="vec2" state="TEXCOORD" />

	<language name="glsl" version="1.2">
		<bind param="modelViewProjectionMatrix" program="vp" />
		<bind param="textureMatrix0" program="vp" />
		<bind param="position" program="vp" />
		<bind param="texcoord" program="vp" />
		<bind param="tex0" program="fp" />
		<bind param="epsilon" program="fp" />
		<bind param="dt" program="fp" />

		<program name="vp" type="vertex">
		<![CDATA[
		attribute vec3 position;
		attribute vec2 texcoord;
		uniform mat4 modelViewProjectionMatrix;
		uniform mat4 textureMatrix0;
		void main() {
			gl_Position = modelViewProjectionMatrix * vec4(position, 1.);
			gl_TexCoord[0] = textureMatrix0 * vec4(texcoord, 0., 1.);
		}
		]]>
		</program>
		<program name="fp" type="fragment">
		<![CDATA[
		#version 120
		uniform sampler2DRect tex0;
		uniform float epsilon, dt;

		float curl(vec2 uv) {
			float L = texture2DRect(tex0, uv - vec2(1.,0.)).g;
			float R = texture2DRect(tex0, uv + vec2(1.,0.)).g;
			float B = texture2DRect(tex0, uv - vec2(0.,1.)).r;
			float T = texture2DRect(tex0, uv + vec2(0.,1.)).r;
			return 0.5 * ((R - L) - (T - B));
		}

		void main() {
			vec2 uv = gl_TexCoord[0].xy;
			vec4 s = texture2DRect(tex0, uv);
			float wL = abs(curl(uv - vec2(1.,0.)));
			float wR = abs(curl(uv + vec2(1.,0.)));
			float wB = abs(curl(uv - vec2(0.,1.)));
			float wT = abs(curl(uv + vec2(0.,1.)));
			vec2 eta = 0.5 * vec2(wR - wL, wT - wB);
			float len = length(eta) + 1e-5;
			eta /= len;
			float w = curl(uv);
			vec2 force = epsilon * vec2(eta.y * w, -eta.x * w);
			vec2 v = s.rg + force * dt;
			gl_FragColor = vec4(v, s.b, s.a);
		}
		]]>
		</program>
	</language>
</jittershader>
