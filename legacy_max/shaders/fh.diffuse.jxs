<?xml version="1.0" encoding="UTF-8"?>
<jittershader name="fh.diffuse">
	<description>
		Dissipative 5-tap blur for thermal diffusion + viscosity.
		Per-channel rates: vel (viscosity), T (thermal diffusivity), D (molecular diffusion).
	</description>
	<param name="tex0" type="int" default="0" />
	<param name="texdim" type="vec2" state="TEXDIM0" />
	<param name="k_vel" type="float" default="0.10" />
	<param name="k_T"   type="float" default="0.22" />
	<param name="k_D"   type="float" default="0.08" />
	<param name="modelViewProjectionMatrix" type="mat4" state="MODELVIEW_PROJECTION_MATRIX" />
	<param name="textureMatrix0" type="mat4" state="TEXTURE0_MATRIX" />
	<param name="position" type="vec3" state="POSITION" />
	<param name="texcoord" type="vec2" state="TEXCOORD" />

	<language name="glsl" version="1.2">
		<bind param="modelViewProjectionMatrix" program="vp" />
		<bind param="textureMatrix0" program="vp" />
		<bind param="position" program="vp" />
		<bind param="texcoord" program="vp" />
		<bind param="tex0" program="fp" />
		<bind param="k_vel" program="fp" />
		<bind param="k_T" program="fp" />
		<bind param="k_D" program="fp" />

		<program name="vp" type="vertex">
		<![CDATA[
		attribute vec3 position;
		attribute vec2 texcoord;
		uniform mat4 modelViewProjectionMatrix;
		uniform mat4 textureMatrix0;
		void main() {
			gl_Position = modelViewProjectionMatrix * vec4(position, 1.);
			gl_TexCoord[0] = textureMatrix0 * vec4(texcoord, 0., 1.);
		}
		]]>
		</program>
		<program name="fp" type="fragment">
		<![CDATA[
		#version 120
		uniform sampler2DRect tex0;
		uniform float k_vel, k_T, k_D;
		void main() {
			vec2 uv = gl_TexCoord[0].xy;
			vec4 C  = texture2DRect(tex0, uv);
			vec4 L  = texture2DRect(tex0, uv - vec2(1.,0.));
			vec4 R  = texture2DRect(tex0, uv + vec2(1.,0.));
			vec4 B  = texture2DRect(tex0, uv - vec2(0.,1.));
			vec4 T  = texture2DRect(tex0, uv + vec2(0.,1.));
			vec4 avg = 0.25 * (L + R + B + T);
			vec4 diff = avg - C;
			vec4 k = vec4(k_vel, k_vel, k_T, k_D);
			gl_FragColor = C + diff * k;
		}
		]]>
		</program>
	</language>
</jittershader>
