MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
;
; qoix 04 - Microtonal Shear
;
; QOIX ships an EDO/SCL microtonal engine, and this app's MicrotonalFFT.swift
; already injects q1-q32 as 32 EDO-spaced bins normalised to [0,1]:
;   q1-q8   sub-bass to low-mid   q9-q16  mid
;   q17-q24 upper-mid             q25-q32 presence to air
;
; The interesting quantity is not any single bin but the DIFFERENCE between
; adjacent ones. When a note sits between two scale degrees both bins fire
; and one wins; that differential is microtonal shear, and it is invisible
; in a 12-TET preset. Here it tilts the field asymmetrically - the image
; leans toward whichever pitch is louder.
;
; Falls back cleanly to bass/mid/treb when no microtonal data is injected,
; so it is not dead weight in a standard Butterchurn host.
;
; NOTE: variable names here avoid a leading underscore. milkdrop-eel-parser
; rejects identifiers like `_denom` with a parse error, which silently kills
; the whole per_frame block.
;
[preset00]
fRating=5.000
fGammaAdj=1.000
fDecay=0.976
fVideoEchoZoom=0.999
fVideoEchoAlpha=0.140
nVideoEchoOrientation=2
nWaveMode=2
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.160
fWaveScale=1.250
fWaveSmoothing=0.650
fWaveParam=0.000
fModWaveAlphaStart=0.720
fModWaveAlphaEnd=1.200
fWarpAnimSpeed=1.100
fWarpScale=1.500
fZoomExponent=1.000
fShader=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.420
sx=1.000
sy=1.000
wave_r=0.482
wave_g=0.525
wave_b=0.961
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=lo = (q1+q2+q3+q4+q5+q6+q7+q8) * 0.125;
per_frame_2=ml = (q9+q10+q11+q12+q13+q14+q15+q16) * 0.125;
per_frame_3=mh = (q17+q18+q19+q20+q21+q22+q23+q24) * 0.125;
per_frame_4=hi = (q25+q26+q27+q28+q29+q30+q31+q32) * 0.125;
per_frame_5=hasmt = above(lo + ml + mh + hi, 0.004);
per_frame_6=lo = hasmt * lo + (1 - hasmt) * bass_att * 0.5;
per_frame_7=ml = hasmt * ml + (1 - hasmt) * mid_att * 0.5;
per_frame_8=mh = hasmt * mh + (1 - hasmt) * mid_att * 0.4;
per_frame_9=hi = hasmt * hi + (1 - hasmt) * treb_att * 0.5;
per_frame_10=shearlo = hasmt * (q8 - q9) + (1 - hasmt) * 0.35 * sin(time * 0.41);
per_frame_11=shearmid = hasmt * (q16 - q17) + (1 - hasmt) * 0.30 * cos(time * 0.33);
per_frame_12=shearhi = hasmt * (q24 - q25) + (1 - hasmt) * 0.28 * sin(time * 0.57);
per_frame_13=fluxhi = hasmt * (abs(q25-q26) + abs(q27-q28) + abs(q29-q30) + abs(q31-q32)) + (1 - hasmt) * treb_att * 0.5;
per_frame_14=denom = lo + ml + mh + hi + 0.001;
per_frame_15=cent = (lo*0.125 + ml*0.375 + mh*0.625 + hi*0.875) / denom;
per_frame_16=spin = spin * 0.92 + shearlo * 0.08;
per_frame_17=q1 = lo;
per_frame_18=q2 = ml + mh;
per_frame_19=q3 = hi;
per_frame_20=q4 = shearlo;
per_frame_21=q5 = shearmid;
per_frame_22=q6 = shearhi;
per_frame_23=q7 = cent;
per_frame_24=q8 = fluxhi;
per_frame_25=decay = 0.970 + min(q1, 1.2) * 0.012;
per_frame_26=warp = 0.35 + q8 * 0.90;
per_pixel_1=rot = spin * 0.35 + q7 * 0.014 * sin(time * 0.7);
per_pixel_2=dx = q4 * 0.010 + q6 * 0.004 * sin(time * 1.1);
per_pixel_3=dy = q5 * 0.010 + q6 * 0.004 * cos(time * 0.9);
per_pixel_4=zoom = 1.0 + q1 * 0.010 - q3 * 0.005;
warp_1=`shader_body {
warp_2=`    float2 d = texsize.zw;
warp_3=`    float2 p = uv - 0.5;
warp_4=`    float3 c = tex2D(sampler_main, uv).xyz;
warp_5=`
warp_6=`    // The shear terms tilt the sampling asymmetrically. A symmetric
warp_7=`    // preset cannot show a pitch sitting between two scale degrees;
warp_8=`    // this leans toward whichever adjacent bin is winning.
warp_9=`    float2 uvb = uv;
warp_10=`    uvb.x += q4 * 0.0075 * (1.0 - uv.y);
warp_11=`    uvb.y += q5 * 0.0075 * uv.x;
warp_12=`    uvb += float2(-p.y, p.x) * (q6 * 0.014);
warp_13=`
warp_14=`    float3 adv = tex2D(sampler_main, uvb).xyz;
warp_15=`
warp_16=`    // Thirty-two radial spokes, one per EDO bin. The spoke angle is the
warp_17=`    // bin index, so a scale with more degrees literally has more spokes.
warp_18=`    float ang = atan2(p.y, p.x);
warp_19=`    float spokes = 0.5 + 0.5 * sin(ang * 32.0 + q7 * 6.2832);
warp_20=`    float ring = exp(-pow(length(p) - (0.16 + q1 * 0.14), 2.0) / 0.0016);
warp_21=`
warp_22=`    float3 indigo = float3(0.357, 0.404, 0.847);
warp_23=`    float3 mint = float3(0.310, 0.788, 0.494);
warp_24=`    float3 coral = float3(0.878, 0.361, 0.361);
warp_25=`
warp_26=`    // centroid picks the hue: low = mint, mid = indigo, high = coral
warp_27=`    float3 tone = lerp(mint, indigo, saturate(q7 * 2.0));
warp_28=`    tone = lerp(tone, coral, saturate(q7 * 2.0 - 1.0));
warp_29=`
warp_30=`    float dep = ring * spokes * (0.20 + q1 * 0.55 + q8 * 0.35);
warp_31=`    adv += tone * dep * saturate(1.0 - adv);
warp_32=`
warp_33=`    ret = adv * 0.9950;
warp_34=`}
comp_1=`shader_body {
comp_2=`    float2 d = texsize.zw;
comp_3=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_4=`    float v = dot(c, float3(0.36, 0.48, 0.30));
comp_5=`
comp_6=`    float3 u0 = float3(0.035, 0.035, 0.051);
comp_7=`    float3 u1 = float3(0.165, 0.251, 0.220);
comp_8=`    float3 u2 = float3(0.357, 0.404, 0.847);
comp_9=`    float3 u3 = float3(0.482, 0.525, 0.961);
comp_10=`    float3 u4 = float3(0.933, 0.965, 0.953);
comp_11=`    float t = saturate(v * 1.60);
comp_12=`    float3 pal = lerp(u0, u1, saturate(t * 4.0));
comp_13=`    pal = lerp(pal, u2, saturate(t * 4.0 - 1.0));
comp_14=`    pal = lerp(pal, u3, saturate(t * 4.0 - 2.0));
comp_15=`    pal = lerp(pal, u4, saturate(t * 4.0 - 3.0));
comp_16=`
comp_17=`    // keep the injected hue rather than flattening everything to the ramp
comp_18=`    pal = lerp(pal, c * 2.2, 0.45);
comp_19=`
comp_20=`    float3 b = (tex2D(sampler_main, uv - float2(3.0 * d.x, 0.0)).xyz + tex2D(sampler_main, uv + float2(3.0 * d.x, 0.0)).xyz + tex2D(sampler_main, uv - float2(0.0, 3.0 * d.y)).xyz + tex2D(sampler_main, uv + float2(0.0, 3.0 * d.y)).xyz) * 0.25;
comp_21=`    pal += float3(0.482, 0.525, 0.961) * dot(b, float3(0.36, 0.48, 0.30)) * 0.48;
comp_22=`
comp_23=`    pal *= 1.13;
comp_24=`    ret = pal / (1.0 + pal);
comp_25=`}
