MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
//
// fluid_heat 05 - Volumetric Lift
//
// The raymarch pass, ported. Six slice samples of the same 2D field are
// accumulated front-to-back at progressively rotated and sheared offsets,
// so a flat buffer reads as a rotating volume of smoke. Alpha compositing
// is real (each slice occludes the ones behind it) which is what sells
// the depth.
//
// Six taps, unrolled - Milkdrop pixel shaders cannot use functions and
// loop support is inconsistent across builds.
//
// Depth/swirl/shear are deliberately gentler than a naive port: every
// sample is the SAME image at an offset, so large values act as a
// directional blur and smear the plumes into mush.
//
fRating=5.000
fGammaAdj=1.000
fDecay=0.983
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=1
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.140
fWaveScale=1.000
fWaveSmoothing=0.700
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=1.000
fWarpAnimSpeed=0.900
fWarpScale=1.300
fZoomExponent=1.000
fShader=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.350
sx=1.000
sy=1.000
wave_r=1.000
wave_g=0.750
wave_b=0.300
wave_x=0.500
wave_y=0.880
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=q1 = bass_att;
per_frame_2=q2 = mid_att;
per_frame_3=q3 = treb_att;
per_frame_4=// camera yaw - the volume turns slowly, faster on loud passages
per_frame_5=q4 = time * 0.17 + bass_att * 0.30;
per_frame_6=// depth of the slice stack (raymarch "thickness")
per_frame_7=q5 = 0.24 + min(mid_att, 1.2) * 0.16;
per_frame_8=// shear - parallax between near and far slices
per_frame_9=q6 = 0.070 + min(treb_att, 1.2) * 0.045;
per_frame_10=decay = 0.980 + min(q1, 1.2) * 0.009;
per_pixel_1=dy = 0.0024 * (1.0 - y) * (0.6 + q1);
per_pixel_2=dx = 0.0012 * sin(y * 6.1 + time * 0.42) * q2;
per_pixel_3=zoom = 1.0 + 0.0022 * q1 * (1.0 - rad);
per_pixel_4=rot = 0.010 * (0.5 - y) * q3;
per_pixel_5=warp = 0.28 + 0.50 * q2;
warp_1=`shader_body {
warp_2=`    float2 d = texsize.zw;
warp_3=`    float3 lw = float3(0.50, 0.35, 0.15);
warp_4=`
warp_5=`    float3 c = tex2D(sampler_main, uv).xyz;
warp_6=`    float heat = dot(c, lw);
warp_7=`
warp_8=`    float2 uvb = uv;
warp_9=`    uvb.y += heat * heat * (0.0036 + 0.0026 * q1);
warp_10=`
warp_11=`    float hl = dot(tex2D(sampler_main, uv - float2(d.x, 0.0)).xyz, lw);
warp_12=`    float hr = dot(tex2D(sampler_main, uv + float2(d.x, 0.0)).xyz, lw);
warp_13=`    float hd = dot(tex2D(sampler_main, uv - float2(0.0, d.y)).xyz, lw);
warp_14=`    float hu = dot(tex2D(sampler_main, uv + float2(0.0, d.y)).xyz, lw);
warp_15=`    float2 g = float2(hr - hl, hu - hd);
warp_16=`    uvb += float2(-g.y, g.x) * (0.014 + 0.038 * q2);
warp_17=`
warp_18=`    float3 adv = tex2D(sampler_main, uvb).xyz;
warp_19=`    adv = lerp(adv, GetBlur1(uvb), 0.10 + 0.14 * q3);
warp_20=`
warp_21=`    float2 j1 = float2(0.30, 0.94);
warp_22=`    float2 j2 = float2(0.50, 0.97);
warp_23=`    float2 j3 = float2(0.70, 0.94);
warp_24=`    float2 r1 = uv - j1;
warp_25=`    float2 r2 = uv - j2;
warp_26=`    float2 r3 = uv - j3;
warp_27=`    float inj = exp(-dot(r1, r1) / 0.0028) * bass_att
warp_28=`              + exp(-dot(r2, r2) / 0.0040) * bass
warp_29=`              + exp(-dot(r3, r3) / 0.0028) * mid_att;
warp_30=`    adv += float3(1.00, 0.70, 0.28) * inj * 0.28 * saturate(1.0 - adv);
warp_31=`
warp_32=`    ret = adv * 0.9955;
warp_33=`}
comp_1=`shader_body {
comp_2=`    float3 lw = float3(0.50, 0.35, 0.15);
comp_3=`
comp_4=`    float3 k0 = float3(0.000, 0.000, 0.000);
comp_5=`    float3 k1 = float3(0.102, 0.000, 0.200);
comp_6=`    float3 k2 = float3(0.902, 0.243, 0.000);
comp_7=`    float3 k3 = float3(1.000, 0.800, 0.000);
comp_8=`    float3 k4 = float3(1.000, 1.000, 1.000);
comp_9=`
comp_10=`    float2 p0 = uv - 0.5;
comp_11=`    float3 acc = float3(0.0, 0.0, 0.0);
comp_12=`    float  alpha = 0.0;
comp_13=`
comp_14=`    // ---- slice 1 (far) ---------------------------------------------
comp_15=`    float z = -0.5 * q5;
comp_16=`    float sa = sin(z * 1.9 + q4);
comp_17=`    float ca = cos(z * 1.9 + q4);
comp_18=`    float2 sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_19=`    sp.x += q6 * z;
comp_20=`    float3 sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_21=`    float sd = dot(sc, lw);
comp_22=`    float a = (1.0 - alpha) * sd * 0.42;
comp_23=`    acc += sc * a; alpha += a;
comp_24=`
comp_25=`    // ---- slice 2 ----------------------------------------------------
comp_26=`    z = -0.3 * q5;
comp_27=`    sa = sin(z * 1.9 + q4); ca = cos(z * 1.9 + q4);
comp_28=`    sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_29=`    sp.x += q6 * z;
comp_30=`    sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_31=`    sd = dot(sc, lw);
comp_32=`    a = (1.0 - alpha) * sd * 0.42;
comp_33=`    acc += sc * a; alpha += a;
comp_34=`
comp_35=`    // ---- slice 3 ----------------------------------------------------
comp_36=`    z = -0.1 * q5;
comp_37=`    sa = sin(z * 1.9 + q4); ca = cos(z * 1.9 + q4);
comp_38=`    sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_39=`    sp.x += q6 * z;
comp_40=`    sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_41=`    sd = dot(sc, lw);
comp_42=`    a = (1.0 - alpha) * sd * 0.42;
comp_43=`    acc += sc * a; alpha += a;
comp_44=`
comp_45=`    // ---- slice 4 ----------------------------------------------------
comp_46=`    z = 0.1 * q5;
comp_47=`    sa = sin(z * 1.9 + q4); ca = cos(z * 1.9 + q4);
comp_48=`    sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_49=`    sp.x += q6 * z;
comp_50=`    sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_51=`    sd = dot(sc, lw);
comp_52=`    a = (1.0 - alpha) * sd * 0.42;
comp_53=`    acc += sc * a; alpha += a;
comp_54=`
comp_55=`    // ---- slice 5 ----------------------------------------------------
comp_56=`    z = 0.3 * q5;
comp_57=`    sa = sin(z * 1.9 + q4); ca = cos(z * 1.9 + q4);
comp_58=`    sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_59=`    sp.x += q6 * z;
comp_60=`    sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_61=`    sd = dot(sc, lw);
comp_62=`    a = (1.0 - alpha) * sd * 0.42;
comp_63=`    acc += sc * a; alpha += a;
comp_64=`
comp_65=`    // ---- slice 6 (near) ---------------------------------------------
comp_66=`    z = 0.5 * q5;
comp_67=`    sa = sin(z * 1.9 + q4); ca = cos(z * 1.9 + q4);
comp_68=`    sp = float2(p0.x * ca - p0.y * sa, p0.x * sa + p0.y * ca);
comp_69=`    sp.x += q6 * z;
comp_70=`    sc = tex2D(sampler_main, saturate(sp + 0.5)).xyz;
comp_71=`    sd = dot(sc, lw);
comp_72=`    a = (1.0 - alpha) * sd * 0.42;
comp_73=`    acc += sc * a; alpha += a;
comp_74=`
comp_75=`    // ---- map the accumulated density through the heat LUT ------------
comp_76=`    float t = saturate(dot(acc, lw) * 2.10);
comp_77=`    float3 pal = lerp(k0, k1, saturate(t * 4.0));
comp_78=`    pal = lerp(pal, k2, saturate(t * 4.0 - 1.0));
comp_79=`    pal = lerp(pal, k3, saturate(t * 4.0 - 2.0));
comp_80=`    pal = lerp(pal, k4, saturate(t * 4.0 - 3.0));
comp_81=`
comp_82=`    float3 col = pal * (0.35 + alpha * 1.30);
comp_83=`    col *= 1.16;
comp_84=`    ret = col / (1.0 + col);
comp_85=`}
