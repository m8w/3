MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
//
// fluid_heat 01 - Boussinesq Plume
//
// Heat rises. Bass drives three injection jets along the floor; hot pixels
// sample from below in the warp shader so they climb, exactly as the
// Boussinesq term f = (alpha*(T - T_amb) - beta*D) * up does in the solver.
// Colour is the 5-stop incandescent blackbody LUT.
//
fRating=5.000
fGammaAdj=1.000
fDecay=0.985
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=7
bAdditiveWaves=1
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=1
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.120
fWaveScale=0.900
fWaveSmoothing=0.750
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.200
fZoomExponent=1.000
fShader=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.400
sx=1.000
sy=1.000
wave_r=0.900
wave_g=0.500
wave_b=0.100
wave_x=0.500
wave_y=0.940
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=// audio -> source terms.  q1 heat, q2 momentum, q3 diffusion.
per_frame_2=q1 = bass_att * 0.5 + bass * 0.5;
per_frame_3=q2 = mid_att;
per_frame_4=q3 = treb_att;
per_frame_5=q4 = q1 * 0.6 + q2 * 0.3 + q3 * 0.1;
per_frame_6=// hotter input dissipates a little slower - long tails on loud passages
per_frame_7=decay = 0.982 + min(q1, 1.5) * 0.008;
per_frame_8=warp = 0.30 + q2 * 0.55;
per_frame_9=// slow drift so the plume never settles into a fixed column
per_frame_10=q5 = sin(time * 0.19) * 0.5 + cos(time * 0.11) * 0.5;
per_pixel_1=// global slow lift, strongest near the floor where the jets live
per_pixel_2=dy = 0.0022 * (1.0 - y) * (1.0 + q1);
per_pixel_3=// lateral shear increasing with height, so plumes lean and braid
per_pixel_4=dx = 0.0016 * sin(y * 7.4 + time * 0.5) * (0.4 + q2) * y;
per_pixel_5=// gentle rotation about the centre, signed by height
per_pixel_6=rot = 0.014 * (0.5 - y) * q3;
per_pixel_7=zoom = 1.0 + 0.0025 * q1 * (1.0 - rad);
warp_1=`shader_body {
warp_2=`    float2 d = texsize.zw;
warp_3=`    float3 lw = float3(0.50, 0.35, 0.15);   // heat weighting of RGB
warp_4=`
warp_5=`    float3 c = tex2D(sampler_main, uv).xyz;
warp_6=`    float heat = dot(c, lw);
warp_7=`
warp_8=`    // ---- Boussinesq buoyancy -------------------------------------
warp_9=`    // v increases downward, so sampling further down pulls content
warp_10=`    // upward: hot pixels rise, cold ones stay put.
warp_11=`    // (If your build's v runs the other way, flip this one sign.)
warp_12=`    float2 uvb = uv;
warp_13=`    uvb.y += heat * heat * (0.0038 + 0.0030 * q1);
warp_14=`
warp_15=`    // ---- vorticity confinement -----------------------------------
warp_16=`    // curl of the heat field, rotated 90 degrees -> tangential swirl
warp_17=`    float hl = dot(tex2D(sampler_main, uv - float2(d.x, 0.0)).xyz, lw);
warp_18=`    float hr = dot(tex2D(sampler_main, uv + float2(d.x, 0.0)).xyz, lw);
warp_19=`    float hd = dot(tex2D(sampler_main, uv - float2(0.0, d.y)).xyz, lw);
warp_20=`    float hu = dot(tex2D(sampler_main, uv + float2(0.0, d.y)).xyz, lw);
warp_21=`    float2 g = float2(hr - hl, hu - hd);
warp_22=`    float2 curl = float2(-g.y, g.x);
warp_23=`    uvb += curl * (0.012 + 0.045 * q2);
warp_24=`
warp_25=`    float3 adv = tex2D(sampler_main, uvb).xyz;
warp_26=`
warp_27=`    // ---- thermal diffusion ---------------------------------------
warp_28=`    float3 dif = GetBlur1(uvb);
warp_29=`    adv = lerp(adv, dif, 0.09 + 0.16 * q3);
warp_30=`
warp_31=`    // ---- audio injection: three jets along the floor -------------
warp_32=`    float2 j1 = float2(0.22 + 0.03 * q5, 0.93);
warp_33=`    float2 j2 = float2(0.50,             0.965);
warp_34=`    float2 j3 = float2(0.78 - 0.03 * q5, 0.93);
warp_35=`    float2 r1 = uv - j1;
warp_36=`    float2 r2 = uv - j2;
warp_37=`    float2 r3 = uv - j3;
warp_38=`    float e1 = exp(-dot(r1, r1) / 0.0030) * bass_att;
warp_39=`    float e2 = exp(-dot(r2, r2) / 0.0042) * bass;
warp_40=`    float e3 = exp(-dot(r3, r3) / 0.0030) * mid_att;
warp_41=`
warp_42=`    // Saturating injection - matches the solver's  x += a*(1-x).
warp_43=`    // Additive injection integrates without bound and clips to white.
warp_44=`    float3 src = float3(1.00, 0.72, 0.30) * (e1 + e2 + e3) * 0.30;
warp_45=`    adv += src * saturate(1.0 - adv);
warp_46=`
warp_47=`    // ---- dissipation ---------------------------------------------
warp_48=`    adv *= 0.9955;
warp_49=`    ret = adv;
warp_50=`}
comp_1=`shader_body {
comp_2=`    float3 lw = float3(0.50, 0.35, 0.15);
comp_3=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_4=`    float t = saturate(dot(c, lw) * 1.45);
comp_5=`
comp_6=`    // 5-stop incandescent blackbody LUT.  Milkdrop shaders have no
comp_7=`    // user functions, so the ramp is an inlined chain of lerps:
comp_8=`    //   0.00 #000000  0.25 #1a0033  0.50 #e63e00
comp_9=`    //   0.75 #ffcc00  1.00 #ffffff
comp_10=`    float3 k0 = float3(0.000, 0.000, 0.000);
comp_11=`    float3 k1 = float3(0.102, 0.000, 0.200);
comp_12=`    float3 k2 = float3(0.902, 0.243, 0.000);
comp_13=`    float3 k3 = float3(1.000, 0.800, 0.000);
comp_14=`    float3 k4 = float3(1.000, 1.000, 1.000);
comp_15=`    float3 pal = lerp(k0, k1, saturate(t * 4.0));
comp_16=`    pal = lerp(pal, k2, saturate(t * 4.0 - 1.0));
comp_17=`    pal = lerp(pal, k3, saturate(t * 4.0 - 2.0));
comp_18=`    pal = lerp(pal, k4, saturate(t * 4.0 - 3.0));
comp_19=`
comp_20=`    // neighbourhood glow from a wider blur tap
comp_21=`    float3 b = GetBlur2(uv);
comp_22=`    float bt = saturate(dot(b, lw) * 1.45);
comp_23=`    float3 gp = lerp(k0, k1, saturate(bt * 4.0));
comp_24=`    gp = lerp(gp, k2, saturate(bt * 4.0 - 1.0));
comp_25=`    gp = lerp(gp, k3, saturate(bt * 4.0 - 2.0));
comp_26=`    gp = lerp(gp, k4, saturate(bt * 4.0 - 3.0));
comp_27=`    pal += gp * bt * 0.38;
comp_28=`
comp_29=`    // Reinhard tonemap - keeps loud passages from flat-clipping
comp_30=`    pal *= 1.15 + 0.25 * q4;
comp_31=`    ret = pal / (1.0 + pal);
comp_32=`}
